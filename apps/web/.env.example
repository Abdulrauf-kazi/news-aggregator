# Copy to apps/web/.env.local and fill in. Never commit .env.local.

# ── Required ────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or local). Include the database name.
MONGODB_URI=mongodb://localhost:27017/news_aggregator
# NextAuth session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Strongly recommended ────────────────────────────────────────────────────
# Redis for caches and sessions (falls back to in-process memory if unset).
REDIS_URL=redis://localhost:6379

# ── Embeddings / deep-learning models ───────────────────────────────────────
# auto (default): HF API if HUGGINGFACE_API_KEY is set, otherwise run MiniLM in-process.
# local: always in-process (transformers.js + ONNX Runtime, ~90 MB model download on first use)
# hf-api: Hugging Face Inference API (needs HUGGINGFACE_API_KEY)
# lexical: no neural embeddings (hash fallback only, for debugging)
EMBEDDING_PROVIDER=auto
# Hugging Face token with "Make calls to Inference Providers" permission (hf-api provider only).
HUGGINGFACE_API_KEY=
# Optional: load the local model from disk instead of downloading it, e.g. /app/.models/
# (directory must contain Xenova/all-MiniLM-L6-v2/{config.json,tokenizer.json,...,onnx/model.onnx}).
EMBEDDING_LOCAL_MODEL_PATH=
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # HF API model
# EMBEDDING_LOCAL_MODEL=Xenova/all-MiniLM-L6-v2            # transformers.js model
# EMBEDDING_API_URL=                                       # override HF router URL
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_REQUEST_TIMEOUT_MS=20000
# EMBEDDING_CACHE_TTL_SECONDS=604800

# ── Model thresholds (calibrated on eval/benchmark.json; see eval/RESULTS.md) ─
# DEDUPE_SIMILARITY_THRESHOLD=0.58
# SEARCH_MIN_SEMANTIC_SIMILARITY=0.3

# ── Ranking / sessions ──────────────────────────────────────────────────────
# TIME_DECAY_LAMBDA=0.08            # recency = exp(-lambda * age_hours)
# EXPLORATION_INJECTION_RATE=0.4
# SESSION_TTL_SECONDS=2700
# GRAPH_CACHE_TTL_SECONDS=600
# VECTOR_SEARCH_TOP_K=5

# ── Optional integrations ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FINNHUB_API_KEY=
FRED_API_KEY=
EIA_API_KEY=
