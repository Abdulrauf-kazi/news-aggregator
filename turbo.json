{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "REDIS_URL",
    "SESSION_TTL_SECONDS",
    "SESSION_SOFT_DECAY_WINDOW_SECONDS",
    "S3_BUCKET",
    "AWS_REGION",
    "S3_PREFIX",
    "GRAPH_CACHE_TTL_SECONDS",
    "TIME_DECAY_LAMBDA",
    "EXPLORATION_INJECTION_RATE",
    "EMBEDDING_MODEL",
    "EMBEDDING_DIM",
    "EMBEDDING_CACHE_TTL_SECONDS",
    "HUGGINGFACE_API_KEY",
    "EMBEDDING_API_URL",
    "EMBEDDING_PROVIDER",
    "EMBEDDING_LOCAL_MODEL",
    "EMBEDDING_LOCAL_MODEL_PATH",
    "EMBEDDING_BATCH_SIZE",
    "EMBEDDING_REQUEST_TIMEOUT_MS",
    "VECTOR_SEARCH_TOP_K",
    "FINNHUB_API_KEY",
    "SEARCH_MIN_SEMANTIC_SIMILARITY",
    "DEDUPE_SIMILARITY_THRESHOLD",
    "MONGODB_URI",
    "AUTH_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
